# Prody local / preview env (copy to .env — never commit secrets)

# PRODY_SECRET_KEY=
# PRODY_DB=sqlite
# PRODY_SQLITE_PATH=./prody_dev.sqlite3

# Turso (optional; falls back to SQLite when unset/unreachable)
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Study rooms video (off by default — calm card until configured)
# ROOM_VIDEO=jitsi          # public meet.jit.si embed, no JWT
# JAAS_APP_ID=              # e.g. vpaas-magic-cookie-… from 8x8 / JaaS dashboard
# JAAS_KID=                 # '<AppID>/<keyid>' header kid for RS256
# JAAS_PRIVATE_KEY=         # PEM (use \n for newlines) — never commit a real key
# JAAS_PRIVATE_KEY_PATH=    # or path to a PEM file outside the repo
# Public JaaS App ID for this project (set JAAS_APP_ID to enable once key+kid are ready):
# vpaas-magic-cookie-2a1bdbb61ab94edbaefb31f7cf4c72b8
